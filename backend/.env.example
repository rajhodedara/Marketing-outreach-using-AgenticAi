GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO

# Vapi (Web SDK — WebRTC, no PSTN phone number needed)
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_PRIVATE_KEY=your_vapi_private_key_here

# LLM provider for Vapi (Groq)
LLM_API_KEY=your_groq_api_key_here

# TTS provider for Vapi (ElevenLabs)
TTS_API_KEY=your_elevenlabs_api_key_here

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Nova backend public URL (e.g. ngrok forwarding address)
NOVA_BACKEND_URL=https://your-ngrok-url.ngrok-free.app

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret